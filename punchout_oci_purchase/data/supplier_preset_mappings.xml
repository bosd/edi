     Cart field-mapping rules for OCI supplier presets. Lives here (not in
     ``punchout_oci``) because ``punchout.field.mapping`` is defined in
     ``punchout_purchase`` — this module depends on both, the preset
     backend module and the mapping framework. -->
<odoo noupdate="1">

    <!-- Van Egmond (SAP OCI 5.0). Its cart puts the GTIN in CUST_FIELD1
         (VENDORMAT is Van Egmond's own article number → supplierinfo
         code, not a barcode) and returns a product image URL in
         ATTACHMENT. -->
    <record id="mapping_vanegmond_barcode" model="punchout.field.mapping">
        <field name="backend_id" ref="punchout_oci.preset_vanegmond" />
        <field name="sequence">10</field>
        <field name="source_field">CUST_FIELD1</field>
        <field name="target">barcode</field>
    </record>
    <record id="mapping_vanegmond_image" model="punchout.field.mapping">
        <field name="backend_id" ref="punchout_oci.preset_vanegmond" />
        <field name="sequence">20</field>
        <field name="source_field">ATTACHMENT</field>
        <field name="target">image</field>
    </record>

    <!-- VENDORMAT -> barcode for the presets that used the old default
         ``oci_barcode_field = VENDORMAT`` (now retired). The barcode
         target validates GTIN shape (8/12/13/14 digits) + uniqueness, so
         a non-GTIN VENDORMAT (e.g. TVH's ``TVH/<num>``) is simply a
         no-op — same as before. -->
    <record id="mapping_indi_barcode" model="punchout.field.mapping">
        <field name="backend_id" ref="punchout_oci.preset_indi" />
        <field name="source_field">VENDORMAT</field>
        <field name="target">barcode</field>
    </record>
    <record id="mapping_phoenix_barcode" model="punchout.field.mapping">
        <field name="backend_id" ref="punchout_oci.preset_phoenix_contact" />
        <field name="source_field">VENDORMAT</field>
        <field name="target">barcode</field>
    </record>
    <record id="mapping_dell_barcode" model="punchout.field.mapping">
        <field name="backend_id" ref="punchout_oci.preset_dell" />
        <field name="source_field">VENDORMAT</field>
        <field name="target">barcode</field>
    </record>
    <record id="mapping_kramp_barcode" model="punchout.field.mapping">
        <field name="backend_id" ref="punchout_oci.preset_kramp" />
        <field name="source_field">VENDORMAT</field>
        <field name="target">barcode</field>
    </record>
    <record id="mapping_discountoffice_barcode" model="punchout.field.mapping">
        <field name="backend_id" ref="punchout_oci.preset_discountoffice" />
        <field name="source_field">VENDORMAT</field>
        <field name="target">barcode</field>
    </record>
    <record id="mapping_tvh_barcode" model="punchout.field.mapping">
        <field name="backend_id" ref="punchout_oci.preset_tvh_industrial" />
        <field name="source_field">VENDORMAT</field>
        <field name="target">barcode</field>
    </record>
    <record id="mapping_destil_barcode" model="punchout.field.mapping">
        <field name="backend_id" ref="punchout_oci.preset_destil" />
        <field name="source_field">VENDORMAT</field>
        <field name="target">barcode</field>
    </record>

</odoo>
