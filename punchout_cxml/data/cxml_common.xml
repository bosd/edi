<odoo>
    <template id="cxml_punchout_request">
        <cXML
            t-att-version="backend._get_cxml_version()"
            t-att-payloadID="session._get_punchout_payload_identity()"
            t-att-timestamp="session._get_punchout_request_timestamp()"
        >
            <t t-call="punchout_cxml.cxml_punchout_header" />
            <Request t-att-deploymentMode="backend.deployment_mode">
                <!-- ``t-out="0"`` is the v17+ replacement for the
                     deprecated ``t-raw="0"``: emits the inner
                     content (the operation-specific body, e.g.
                     PunchOutSetupRequest) without HTML-escaping. -->
                <t t-out="0" />
            </Request>
        </cXML>
    </template>

    <template id="cxml_punchout_header">
        <!-- IMPORTANT: keep ``<t t-esc=...>`` inline with its parent
             element. Qweb preserves the surrounding whitespace, and
             cXML servers compare the credential / identity strings
             against their database BYTE-FOR-BYTE. Indented values
             like ``\n    FaboryDemo\n    `` get rejected with
             "Unable to find customer for given credentials" because
             the supplier looks up the entire whitespace-padded
             string, not the trimmed identity. -->
        <Header>
            <From>
                <Credential t-att-domain="backend.from_domain">
                    <Identity>
                        <t t-esc="backend.from_identity" />
                    </Identity>
                </Credential>
            </From>
            <To>
                <Credential t-att-domain="backend.to_domain">
                    <Identity>
                        <t t-esc="backend.to_identity" />
                    </Identity>
                </Credential>
            </To>
            <!-- Sender is the buyer authenticating itself. Most
                 suppliers expect Sender = From (same domain + identity);
                 the model carries a single ``from_*`` pair and reuses
                 it here. -->
            <Sender>
                <Credential t-att-domain="backend.from_domain">
                    <Identity>
                        <t t-esc="backend.from_identity" />
                    </Identity>
                    <SharedSecret>
                        <t t-esc="backend.shared_secret" />
                    </SharedSecret>
                </Credential>
                <UserAgent>
                    <t t-esc="backend.user_agent" />
                </UserAgent>
            </Sender>
        </Header>
    </template>
</odoo>
