<!--
    Fabory cXML demo override. Loaded only when Odoo is started
    with demo data enabled (``without_demo=False``, runboat default);
    never present on production installs that omit demo data.

    Reuses the SAME XML id as the archived preset
    (``preset_fabory``) — Odoo loads demo files after data files,
    so the second load overrides the first. Result on a demo
    install: the Fabory record exists, is active, is in state
    "open", and ships with Fabory's published "FaboryDemo" public
    demo credentials so users can click "Open Catalog" to test
    end-to-end without manager intervention.

    Production users who pull the regular (non-demo) install
    still get the archived ``REPLACE_ME`` preset and adopt it as
    documented in CONFIGURE.md.
-->
<odoo noupdate="1">
    <record id="preset_fabory" model="punchout.backend">
        <field name="from_identity">FaboryDemo</field>
        <field name="shared_secret">F@bory12</field>
        <field name="active" eval="True" />
        <field name="state">open</field>
    </record>
</odoo>
