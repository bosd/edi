<odoo>
    <!--FORM view: split into Connection (manager) + Advanced (system).
        The manager tier is the functional consultant / application
        manager — they should be able to set up a backend (link the
        partner, enter credentials, switch state, archive what they
        don't need) without exposure to URL / timeout / retention
        knobs. Those live in the Advanced group, ``groups=base.group_system``. -->
    <record model="ir.ui.view" id="punchout_backend_form_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="redirect_to_backend"
                        type="object"
                        icon="fa-sign-in"
                        string="Access"
                        invisible="state != 'open' or not active"
                    />
                    <field name="state" widget="statusbar" options="{'clickable': 1}" />
                </header>
                <sheet>
                    <!-- Standard archived ribbon — visible whenever
                         the backend is archived. Compose with
                         ``state="closed"`` for fully decommissioned
                         backends; ``active=False`` alone is the "park
                         a shipped preset I haven't adopted" state. -->
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="1" />
                    <div name="button_box" class="oe_button_box">
                        <button
                            name="action_view_sessions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-history"
                        >
                            <field
                                name="session_count"
                                widget="statinfo"
                                string="Sessions"
                            />
                        </button>
                    </div>
                    <field name="image_128" widget="image" class="oe_avatar" />
                    <div class="oe_title">
                        <label
                            for="name"
                            string="PunchOut Backend"
                            class="oe_read_only"
                        />
                        <label for="name" class="oe_edit_only" />
                        <h1 class="oe_title">
                            <field name="name" />
                        </h1>
                    </div>
                    <group name="group_main">
                        <group name="group_connection" string="Connection">
                            <field name="description" />
                            <field name="protocol" />
                        </group>
                        <group name="group_credentials" string="Credentials">
                            <field name="auth_username" />
                            <field name="auth_password" password="True" />
                            <field name="auth_customer_number" />
                        </group>
                    </group>
                    <group
                        name="group_advanced"
                        string="Advanced (technical)"
                        groups="base.group_system"
                    >
                        <group>
                            <field name="url" />
                            <field name="browser_form_post_url" />
                        </group>
                        <group>
                            <field name="session_duration" />
                            <field name="session_retention_days" />
                            <field name="max_response_size" />
                        </group>
                    </group>
                    <notebook>
                        <page
                            string="UoM Mappings"
                            name="uom_mappings"
                            groups="base.group_system"
                        >
                            <field
                                name="uom_mapping_ids"
                                context="{'default_backend_id': id}"
                            >
                                <list editable="bottom">
                                    <field name="supplier_code" />
                                    <field name="uom_id" />
                                    <field name="notes" optional="hide" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <!--TREE view-->
    <record model="ir.ui.view" id="punchout_backend_tree_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="description" />
                <field name="protocol" />
                <field name="state" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>
    <!--SEARCH view-->
    <record model="ir.ui.view" id="punchout_backend_search_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="url" />
                <field name="protocol" />
                <filter
                    name="filter_open"
                    string="Open"
                    domain="[('state', '=', 'open')]"
                />
                <filter
                    name="filter_draft"
                    string="Draft (needs setup)"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group name="groupby">
                    <filter
                        name="group_by_protocol"
                        string="Protocol"
                        context="{'group_by': 'protocol'}"
                    />
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <!--KANBAN view: tile-per-supplier picker. The default action
        domain pins this to ``state=open`` (which already implies
        ``active=True`` since archived records are auto-filtered),
        so users see only suppliers they can actually punch out to. -->
    <record model="ir.ui.view" id="punchout_backend_kanban_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" default_order="name" sample="1">
                <field name="id" />
                <field name="name" />
                <field name="description" />
                <field name="protocol" />
                <field name="image_128" />
                <field name="state" />
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-row align-items-center">
                            <field
                                name="image_128"
                                widget="image"
                                class="o_image_64_cover me-3"
                                options="{'preview_image': 'image_128'}"
                            />
                            <div class="flex-grow-1">
                                <strong>
                                    <field name="name" />
                                </strong>
                                <div class="text-muted small">
                                    <field name="description" />
                                </div>
                                <div class="mt-1">
                                    <span class="badge text-bg-info">
                                        <field name="protocol" />
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom mt-2">
                            <button
                                name="redirect_to_backend"
                                type="object"
                                class="btn btn-primary btn-sm w-100"
                            >
                                <i class="fa fa-sign-in me-1" /> Open Catalog
                            </button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--ACTION-->
    <record model="ir.actions.act_window" id="punchout_backend_act_window">
        <field name="name">Punchout Backends</field>
        <field name="res_model">punchout.backend</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
    <!--MENUS-->
    <record model="ir.ui.menu" id="punchout_menu">
        <field name="name">PunchOut</field>
        <field name="parent_id" ref="base.menu_custom" />
        <field name="sequence" eval="150" />
    </record>
    <record model="ir.ui.menu" id="punchout_backend_menu">
        <field name="name">PunchOut Backends</field>
        <field name="parent_id" ref="punchout.punchout_menu" />
        <field name="action" ref="punchout.punchout_backend_act_window" />
        <field name="sequence" eval="10" />
    </record>
</odoo>
