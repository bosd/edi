<odoo>
    <!--FORM view: state-aware ribbons + Connection / Credentials /
        Advanced split, mirroring Odoo's payment.provider UX. The
        manager tier is the functional consultant / application
        manager — they should be able to set up a backend (link the
        partner, enter credentials, switch state, archive what they
        don't need) without exposure to URL / timeout / retention
        knobs. Those live in the Advanced group, ``groups=base.group_system``. -->
    <record model="ir.ui.view" id="punchout_backend_form_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="redirect_to_backend"
                        type="object"
                        icon="fa-sign-in"
                        string="Access"
                        invisible="state != 'open' or not active"
                    />
                    <field name="state" widget="statusbar" options="{'clickable': 1}" />
                </header>
                <sheet>
                    <!-- State-aware ribbons. Order matters — first
                         match wins, more specific states above more
                         general ones. ``Archived`` (active=False) is
                         the loudest signal: shipped preset not yet
                         adopted; it overrides whatever ``state`` says. -->
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-secondary"
                        invisible="active"
                    />
                    <widget
                        name="web_ribbon"
                        title="Closed"
                        bg_color="text-bg-danger"
                        invisible="not active or state != 'closed'"
                    />
                    <widget
                        name="web_ribbon"
                        title="Setup needed"
                        bg_color="text-bg-warning"
                        invisible="not active or state != 'draft'"
                    />
                    <field name="active" invisible="1" />
                    <div name="button_box" class="oe_button_box">
                        <button
                            name="action_view_sessions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-history"
                        >
                            <field
                                name="session_count"
                                widget="statinfo"
                                string="Sessions"
                            />
                        </button>
                    </div>
                    <field name="image_128" widget="image" class="oe_avatar" />
                    <div class="oe_title">
                        <label
                            for="name"
                            string="PunchOut Backend"
                            class="oe_read_only"
                        />
                        <label for="name" class="oe_edit_only" />
                        <h1 class="oe_title">
                            <field name="name" />
                        </h1>
                    </div>
                    <group name="group_main">
                        <group name="group_connection" string="Connection">
                            <field name="description" />
                            <field name="protocol" />
                            <field name="order_transmission" />
                        </group>
                        <!-- cXML/IDS use their own credential fields. -->
                        <group
                            name="group_credentials"
                            string="Credentials"
                            invisible="protocol in ('cxml', 'ids')"
                        >
                            <field name="auth_username" />
                            <field name="auth_password" password="True" />
                            <field name="auth_customer_number" />
                        </group>
                    </group>
                    <group
                        name="group_advanced"
                        string="Advanced (technical)"
                        groups="base.group_system"
                    >
                        <group>
                            <field name="url" />
                            <field name="browser_form_post_url" />
                        </group>
                        <group>
                            <field name="session_duration" />
                            <field name="session_retention_days" />
                            <field name="max_response_size" />
                        </group>
                    </group>
                    <notebook>
                        <page
                            string="UoM Mappings"
                            name="uom_mappings"
                            groups="base.group_system"
                        >
                            <field
                                name="uom_mapping_ids"
                                context="{'default_backend_id': id}"
                            >
                                <list editable="bottom">
                                    <field name="supplier_code" />
                                    <field name="uom_id" />
                                    <field name="notes" optional="hide" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <!--TREE view-->
    <record model="ir.ui.view" id="punchout_backend_tree_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="description" />
                <field name="protocol" />
                <field name="state" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>
    <!--SEARCH view-->
    <record model="ir.ui.view" id="punchout_backend_search_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="url" />
                <field name="protocol" />
                <filter
                    name="filter_open"
                    string="Open"
                    domain="[('state', '=', 'open')]"
                />
                <filter
                    name="filter_draft"
                    string="Draft (needs setup)"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group name="groupby">
                    <filter
                        name="group_by_protocol"
                        string="Protocol"
                        context="{'group_by': 'protocol'}"
                    />
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <!--KANBAN (catalog): manager-facing view of every backend
        including archived presets. Layout follows Odoo's
        payment.provider kanban: 64×64 logo on the left in an
        ``<aside>``, supplier name + description + state badges in
        ``o_record_main`` on the right. Click anywhere on the tile
        opens the form (default kanban behaviour). The explicit
        "Open Catalog" button is shown only on live tiles —
        non-live tiles get an "Activate" button instead, which also
        opens the form so the manager can fill in credentials and
        flip the state to Open. -->
    <record model="ir.ui.view" id="punchout_backend_kanban_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <kanban default_order="name" sample="1">
                <field name="id" />
                <field name="name" />
                <field name="description" />
                <field name="protocol" />
                <field name="image_128" />
                <field name="state" />
                <field name="active" />
                <templates>
                    <t t-name="card">
                        <aside class="me-2">
                            <!-- ``o_image_64_contain`` = a fixed 64x64 box
                                 with ``object-fit: contain``. The image
                                 widget renders the img at the field's pixel
                                 size (128x128), so ``o_image_64_max`` (which
                                 only caps max-width/height, no object-fit)
                                 let wide logos stretch to fill the square.
                                 ``_contain`` letterboxes them instead,
                                 preserving aspect ratio. -->
                            <field
                                name="image_128"
                                widget="image"
                                class="o_image_64_contain mb-0"
                            />
                        </aside>
                        <div class="o_record_main d-flex flex-column flex-grow-1">
                            <div class="fw-bold fs-4">
                                <field name="name" />
                            </div>
                            <div class="fs-6 text-muted mb-1">
                                <field name="description" />
                            </div>
                            <div class="d-flex flex-wrap">
                                <!-- State badges (rounded-pill, same
                                     style as payment.provider). Order
                                     of t-if matches form ribbon
                                     order: archived overrides state. -->
                                <span
                                    t-if="!record.active.raw_value"
                                    class="badge rounded-pill text-bg-secondary me-1"
                                >Archived</span>
                                <span
                                    t-if="record.active.raw_value and record.state.raw_value === 'open'"
                                    class="badge rounded-pill text-bg-success me-1"
                                >Live</span>
                                <span
                                    t-if="record.active.raw_value and record.state.raw_value === 'draft'"
                                    class="badge rounded-pill text-bg-warning me-1"
                                >Setup needed</span>
                                <span
                                    t-if="record.active.raw_value and record.state.raw_value === 'closed'"
                                    class="badge rounded-pill text-bg-danger me-1"
                                >Closed</span>
                                <!-- Protocol badge: manager-only, sits
                                     last so it doesn't dominate the
                                     state-cue colour. -->
                                <span
                                    class="badge rounded-pill text-bg-info"
                                    groups="punchout.group_punchout_manager"
                                >
                                    <field name="protocol" />
                                </span>
                            </div>
                            <!-- ``mt-auto`` pushes the footer to the
                                 bottom regardless of the description's
                                 length so all tiles align consistently. -->
                            <footer class="mt-auto d-flex justify-content-end">
                                <!-- Live: jump to supplier catalog. -->
                                <button
                                    name="redirect_to_backend"
                                    type="object"
                                    class="btn btn-primary btn-sm"
                                    invisible="state != 'open' or not active"
                                >
                                    <i class="fa fa-sign-in me-1" /> Open Catalog
                                </button>
                                <!-- Non-live (archived / draft / closed):
                                     explicit Activate button unarchives
                                     the record (if archived) and opens
                                     the form so the manager can fill
                                     credentials and set state to Open.
                                     Same pattern as Odoo's
                                     payment.provider Disabled tiles. -->
                                <button
                                    name="action_setup_form"
                                    type="object"
                                    class="btn btn-secondary btn-sm"
                                    invisible="state == 'open' and active"
                                >
                                    <i class="fa fa-cog me-1" /> Activate
                                </button>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--KANBAN (picker): end-user-facing view. Same payment-provider
        layout as the catalog kanban but minimal: just a 64×64 logo
        and the supplier name. No description (avoids leaking
        configuration details set by managers), no state badges
        (strict domain pre-filters to live + active), no protocol
        badge (technical info, gated to manager anyway). Single big
        "Open Catalog" button. Strict domain (``state=open AND
        active=True``) is on the action, not the view. -->
    <record model="ir.ui.view" id="punchout_backend_picker_kanban_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <kanban default_order="name" sample="1" create="0">
                <field name="id" />
                <field name="name" />
                <field name="image_128" />
                <templates>
                    <t t-name="card">
                        <aside class="me-2">
                            <!-- Fixed 64x64 box + object-fit:contain so wide
                                 logos keep their aspect ratio (see the main
                                 backend kanban above). -->
                            <field
                                name="image_128"
                                widget="image"
                                class="o_image_64_contain mb-0"
                            />
                        </aside>
                        <div class="o_record_main d-flex flex-column flex-grow-1">
                            <div class="fw-bold fs-4">
                                <field name="name" />
                            </div>
                            <footer class="mt-auto d-flex justify-content-end">
                                <button
                                    name="redirect_to_backend"
                                    type="object"
                                    class="btn btn-primary btn-sm"
                                >
                                    <i class="fa fa-sign-in me-1" /> Open Catalog
                                </button>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--ACTION (catalog): manager-facing. ``active_test: False``
        opens the catalog including archived presets. Gated to
        the manager group so the action (and its menu) is hidden
        from base.group_user. In v19 ``ir.ui.menu`` no longer
        carries ``groups_id``; visibility is enforced via the
        action's groups instead. -->
    <record model="ir.actions.act_window" id="punchout_backend_act_window">
        <field name="name">Punchout Backends</field>
        <field name="res_model">punchout.backend</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{"active_test": False}</field>
        <field name="group_ids" eval="[(4, ref('punchout.group_punchout_manager'))]" />
    </record>
    <!--ACTION (picker): end-user-facing. Strict domain — only live
        backends. References the picker kanban view explicitly so
        the catalog kanban doesn't leak into the user view. -->
    <record model="ir.actions.act_window" id="punchout_supplier_picker_act_window">
        <field name="name">Suppliers</field>
        <field name="res_model">punchout.backend</field>
        <field name="view_mode">kanban</field>
        <field name="domain">[("state", "=", "open"), ("active", "=", True)]</field>
        <field name="context">{}</field>
    </record>
    <record
        id="punchout_supplier_picker_act_window_view_kanban"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="1" />
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="punchout_backend_picker_kanban_view" />
        <field name="act_window_id" ref="punchout_supplier_picker_act_window" />
    </record>
    <!--MENUS-->
    <record model="ir.ui.menu" id="punchout_menu">
        <field name="name">PunchOut</field>
        <field name="parent_id" ref="base.menu_custom" />
        <field name="sequence" eval="150" />
    </record>
    <!--Manager-tier: the catalog (all backends including archived).
        Lives under the technical PunchOut menu. The action's
        ``groups_id`` already gates visibility — no need to repeat
        it on the menu (and ``ir.ui.menu`` no longer accepts it
        in v19). -->
    <record model="ir.ui.menu" id="punchout_backend_menu">
        <field name="name">PunchOut Backends</field>
        <field name="parent_id" ref="punchout.punchout_menu" />
        <field name="action" ref="punchout.punchout_backend_act_window" />
        <field name="sequence" eval="10" />
    </record>
</odoo>
