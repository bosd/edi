<odoo>
    <!-- User: read backends so they can use Browse Catalog. -->
    <record model="ir.model.access" id="punchout_backend_access_user">
        <field name="name">punchout.backend access user</field>
        <field name="model_id" ref="punchout.model_punchout_backend" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
    <!-- Manager: full write. Field-level visibility (URL, timeouts,
         retention, raw protocol params) is gated in the form view via
         ``groups="base.group_system"`` so the manager UI stays clean. -->
    <record model="ir.model.access" id="punchout_backend_access_manager">
        <field name="name">punchout.backend access manager</field>
        <field name="model_id" ref="punchout.model_punchout_backend" />
        <field name="group_id" ref="punchout.group_punchout_manager" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
