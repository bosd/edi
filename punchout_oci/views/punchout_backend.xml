<odoo>
    <record model="ir.ui.view" id="punchout_backend_form_view_oci">
        <field name="name">punchout.backend.form.oci</field>
        <field name="model">punchout.backend</field>
        <field name="inherit_id" ref="punchout.punchout_backend_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_advanced']" position="inside">
                <!-- OCI-specific technical knobs. The mapping fields
                     translate the generic auth_* values into whatever
                     form-param names the supplier expects (USERNAME vs
                     username vs LOGIN, etc.). Defaults work for most
                     OCI suppliers; presets override per supplier. -->
                <group
                    name="group_oci_settings"
                    string="OCI"
                    invisible="protocol != 'oci'"
                >
                    <field name="oci_version" />
                    <field name="oci_param_username" />
                    <field name="oci_param_password" />
                    <field name="oci_param_customer" />
                    <field name="oci_custom_parameters" password="True" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
