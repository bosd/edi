<!--
    INDI OCI demo override. Loaded only when Odoo is started with
    demo data enabled (``without_demo=False``, runboat default);
    never present on production installs that omit demo data.

    Reuses the SAME XML id as the archived preset (``preset_indi``)
    so on a demo install the record exists, is active, and is in
    state "open" — the supplier shows up immediately on the
    end-user picker view.

    Credentials are NOT pre-filled — INDI's docs publish the URL
    and parameter shape openly but actual USERNAME / PASSWORD are
    issued per-customer. The user can plug in any test
    credentials they have, or simply browse the (visible) tile
    layout without clicking through.
-->
<odoo noupdate="1">
    <record id="preset_indi" model="punchout.backend">
        <field name="active" eval="True" />
        <field name="state">open</field>
    </record>
</odoo>
