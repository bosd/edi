<!--
    Pre-configured OCI supplier presets shipped with the module.

    Each preset is created with ``active=False`` and ``state="draft"``
    so it sits in the catalog without showing up in default views or
    accepting traffic. To adopt a preset:

        1. Filter the backend list to "Archived" (or browse from the
           kanban with the archive filter on).
        2. Open the supplier you want, unarchive.
        3. Link your ``partner_id`` (the supplier's existing res.partner).
        4. Set the credentials in ``auth_username`` / ``auth_password``
           (and ``auth_customer_number`` where the supplier requires
           one).
        5. Switch state to ``open``.

    ``noupdate="1"`` so module upgrades don't reset customer changes.

    Community-curated, not endorsed. Each preset reflects the public
    documentation of the supplier at the time of contribution; APIs
    change. Verify against the supplier's current docs before going
    live, and PR fixes here when they drift.
-->
<odoo noupdate="1">
    <!-- ====================================================
         INDI (NL) — industrial supply
         Public docs: https://www.indi.nl/nl-nl/slim-inkopen/erp-connecties/oci-punchout
         Auth pattern: USERNAME + PASSWORD form params (matches OCI defaults).
         No customer number required.
    ==================================================== -->
    <record id="preset_indi" model="punchout.backend">
        <field name="name">INDI</field>
        <field
            name="description"
        >Industrial supplier (NL). OCI Roundtrip catalog with USERNAME/PASSWORD authentication.</field>
        <field name="protocol">oci</field>
        <field
            name="url"
        >https://www.indi.nl/INTERSHOP/web/WFS/org-webshop-Site/nl_NL/-/EUR/ViewOCICatalog-Start</field>
        <field name="browser_form_post_url">/punchout/oci/receive/</field>
        <field name="oci_version">4.0</field>
        <!-- Defaults USERNAME / PASSWORD apply — INDI uses the
             standard names. No customer number required. -->
        <field
            name="image_128"
            type="base64"
            file="punchout_oci/static/description/suppliers/indi.png"
        />
        <field name="active" eval="False" />
        <field name="state">draft</field>
    </record>

    <!-- ====================================================
         Phoenix Contact (DE) — industrial automation / electrical
         connection components
         Public PDF docs:
             https://assets.phoenixcontact.com/file/6cdb9294-a10c-4032-ab0a-1c5c9044c324/media/original?Dokumentation_Punchout_V1_EN.pdf
         Title: "PhoenixContact OCI 4.0 / 5.0 PunchOut" v1.1, 22.06.2022.
         Doc explicitly supports OCI 4.0 + a subset of OCI 5.0 (cart
         transfer; no Detailed-Product-Display / Validation /
         Sourcing). Treat as 4.0 for safety — preset uses that.
         Auth pattern: uppercase ``USERNAME`` / ``PASSWORD`` (matches
         OCI defaults). No customer number — auth is purely user/pass,
         account identity bound to credentials server-side.
         Quirks documented for downstream cart-import mappers:
           * NEW_ITEM-MATGROUP = eCl@ss 11.0 number (same vocabulary
             as TVH).
           * NEW_ITEM-CUST_FIELD1 = delivery date (NOT free-text).
           * NEW_ITEM-VENDORMAT, EXT_PRODUCT_ID, MANUFACTMAT all
             carry the same Product No. (redundant but harmless).
           * Phoenix Contact will configure custom mappings per
             customer on request — verify yours before going live.
    ==================================================== -->
    <record id="preset_phoenix_contact" model="punchout.backend">
        <field name="name">Phoenix Contact</field>
        <field
            name="description"
        >Industrial automation / electrical connection components (DE). OCI 4.0 PunchOut with USERNAME/PASSWORD authentication. Cart return uses eCl@ss in NEW_ITEM-MATGROUP and CUST_FIELD1 = delivery date.</field>
        <field name="protocol">oci</field>
        <field
            name="url"
        >https://punchout.phoenixcontact.com/gateway/v1/oci/handle</field>
        <field name="browser_form_post_url">/punchout/oci/receive/</field>
        <field name="oci_version">4.0</field>
        <!-- Defaults USERNAME / PASSWORD apply. No customer number
             param — the doc explicitly omits it. -->
        <field name="oci_param_customer" />
        <field
            name="image_128"
            type="base64"
            file="punchout_oci/static/description/suppliers/phoenix_contact.png"
        />
        <field name="active" eval="False" />
        <field name="state">draft</field>
    </record>

    <!-- ====================================================
         Kramp (NL/EU) — agricultural / forestry / earthmoving parts
         Public docs: https://developer.kramp.com/oci (developer-portal
         page; the form-spec used here was downloaded from Kramp's site
         and reproduced in this preset's comments).

         Auth pattern is *different* from most OCI suppliers:

         * No password. Kramp validates incoming sessions by
           **HOOK_URL domain match** — the customer's domain is
           registered up-front with Kramp's Business Solution
           Consultant. ``logonId`` is sent (mapped through
           ``oci_param_username``) but Kramp's docs explicitly note
           "will NOT be used for an automatic login!!".
         * Per-customer URL. The catalog endpoint is provisioned by
           Kramp per organisation (static URL) or per-organisation
           domain (dynamic URL); the preset URL below is the
           example from the docs (``OCITesting``) and **must be
           replaced** with the URL Kramp gives you after
           registration.

         Cart-return quirks Kramp expects to be echoed back:

         * ``NEW_ITEM-EXT_QUOTE_ID`` — Kramp's quotation identifier;
           Kramp sends it in the punchout form and expects it back
           on each line so it can match the cart to the originating
           quote.
         * ``NEW_ITEM-CUST_FIELD5`` — per-line user remark (optional).
           Mappers downstream of this preset shouldn't assume
           CUST_FIELD5 is generic supplier metadata for Kramp.

         Optional URL params worth knowing about (set via the
         ``oci_custom_parameters`` escape hatch when needed):
           - ``OCI_VERSION``   already handled by backend.oci_version
           - ``storeId``       which KRAMP-WebShop the user lands on
    ==================================================== -->
    <record id="preset_kramp" model="punchout.backend">
        <field name="name">Kramp</field>
        <field
            name="description"
        >Agricultural / forestry / earthmoving parts (NL/EU). OCI PunchOut. URL is provisioned per-customer by Kramp — REPLACE the example URL after Kramp registers your HOOK_URL domain. Auth is via domain validation; logonId only, no password.</field>
        <field name="protocol">oci</field>
        <!-- Example URL only — Kramp Business Solution Consultant
             will provision the real one for your account. -->
        <field name="url">https://www.kramp.com/do/action/OCITesting</field>
        <field name="browser_form_post_url">/punchout/oci/receive/</field>
        <field name="oci_version">4.0</field>
        <!-- Kramp uses ``logonId`` (not USERNAME) for the user
             identifier. No password — clear the field so the URL
             builder doesn't emit an empty PASSWORD=. -->
        <field name="oci_param_username">logonId</field>
        <field name="oci_param_password" />
        <field name="oci_param_customer" />
        <field
            name="image_128"
            type="base64"
            file="punchout_oci/static/description/suppliers/kramp.png"
        />
        <field name="active" eval="False" />
        <field name="state">draft</field>
    </record>

    <!-- ====================================================
         DiscountOffice (NL) — office supplies
         Public docs: https://oci.discountoffice.nl/docs/default/configure
         Auth pattern: lowercase ``username`` / ``password`` form params
         (like TVH; deviates from the OCI-conventional uppercase).
         No customer number required — auth is purely user/pass.
         Quirk: ``NEW_ITEM-CUST_FIELD1`` carries the line's VAT
         percentage. Mappers downstream of the cart-import shouldn't
         assume CUST_FIELD1 is free-text for this supplier.
    ==================================================== -->
    <record id="preset_discountoffice" model="punchout.backend">
        <field name="name">DiscountOffice</field>
        <field
            name="description"
        >Office supplies (NL). OCI PunchOut with lowercase username / password authentication. Cart returns NEW_ITEM-CUST_FIELD1 = VAT percent.</field>
        <field name="protocol">oci</field>
        <field name="url">https://oci.discountoffice.nl/login</field>
        <field name="browser_form_post_url">/punchout/oci/receive/</field>
        <field name="oci_version">4.0</field>
        <field name="oci_param_username">username</field>
        <field name="oci_param_password">password</field>
        <!-- DiscountOffice doesn't take a customer number param. -->
        <field name="oci_param_customer" />
        <field
            name="image_128"
            type="base64"
            file="punchout_oci/static/description/suppliers/discount_office.png"
        />
        <field name="active" eval="False" />
        <field name="state">draft</field>
    </record>

    <!-- ====================================================
         TVH (BE) — forklift / material-handling parts
         Public spec: TVH OCI EMEA documentation (provided to customers).
         Auth pattern: lowercase ``username`` / ``password`` form params
         (deviates from the OCI-conventional uppercase).
         No customer number param — TVH embeds account context in
         the username.

         Three URL options depending on TVH account type:
           - Industrial:   https://eshop.tvh.com/punch_out_cred
           - Agricultural: https://shop.bepcoparts.com/punch_out_cred
                           https://agri.shop.tvh.com/punch_out_cred
         The preset uses Industrial; switch the URL after unarchiving
         if you have a different account type.
    ==================================================== -->
    <record id="preset_tvh_industrial" model="punchout.backend">
        <field name="name">TVH (Industrial)</field>
        <field
            name="description"
        >Forklift / material-handling parts supplier (BE/global). OCI 4.0 PunchOut. Industrial e-shop URL — switch to bepcoparts/agri.shop for an Agricultural account.</field>
        <field name="protocol">oci</field>
        <field name="url">https://eshop.tvh.com/punch_out_cred</field>
        <field name="browser_form_post_url">/punchout/oci/receive/</field>
        <field name="oci_version">4.0</field>
        <field name="oci_param_username">username</field>
        <field name="oci_param_password">password</field>
        <!-- TVH doesn't take a customer number parameter; clearing the
             default keeps the generic field unused on the form. -->
        <field name="oci_param_customer" />
        <field
            name="image_128"
            type="base64"
            file="punchout_oci/static/description/suppliers/tvh-parts.png"
        />
        <field name="active" eval="False" />
        <field name="state">draft</field>
    </record>
</odoo>
