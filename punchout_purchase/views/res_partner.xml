<odoo>
    <record id="view_partner_form_punchout" model="ir.ui.view">
        <field name="name">res.partner.form.punchout</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- Adoption nudge: this supplier has a punchout backend that
                 isn't activated yet. Show buyers a hint + a one-click
                 "Request punchout setup" that pings the Punchout Manager.
                 Hidden from managers (they can just activate it). -->
            <xpath expr="//sheet/*[1]" position="before">
                <field name="has_dormant_punchout_backend" invisible="1" />
                <div
                    class="alert alert-info mb-0"
                    role="alert"
                    invisible="not has_dormant_punchout_backend"
                    groups="!punchout_purchase.group_punchout_manager"
                >
                    Punchout ordering is available for this supplier but not
                    yet activated. Ask your ERP manager to switch it on so you
                    can order directly from their catalog.
                    <button
                        name="action_request_punchout_setup"
                        type="object"
                        class="btn btn-link p-0 align-baseline"
                        string="Request punchout setup"
                    />
                </div>
            </xpath>
            <!-- "Browse catalog" button on the contact form, visible
                 once the partner has any open punchout backend.
                 Useful for ad-hoc lookup ("I want to find a part from
                 vendor X but haven't decided what yet"). Gated on
                 ``has_punchout_backend`` alone — NOT on supplier_rank:
                 a punchout vendor may keep supplier_rank 0 (POs booked
                 on a sibling contact) yet its catalog is still usable,
                 so the button must show wherever a backend is wired. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_punchout_catalog"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    invisible="not has_punchout_backend"
                >
                    <span class="o_stat_text">Punchout</span>
                </button>
            </xpath>
            <!-- Product URL Template (deep-link) — surface near the
                 partner's Sales/Purchases tab. -->
            <xpath expr="//field[@name='ref']" position="after">
                <field
                    name="product_url_template"
                    placeholder="https://eshop.example.com/parts/{vendor_code}"
                    invisible="supplier_rank == 0"
                />
            </xpath>
        </field>
    </record>

    <!-- "Punchout Supplier" filter on the contacts search view: surfaces
         the vendors we have a punchout connection with (usually the
         preferred suppliers). Backed by the searchable
         ``has_punchout_backend`` field. -->
    <record id="view_res_partner_filter_punchout" model="ir.ui.view">
        <field name="name">res.partner.select.punchout</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter
                    name="punchout_supplier"
                    string="Punchout Supplier"
                    domain="[('has_punchout_backend', '=', True)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
