<odoo>
    <record model="ir.ui.view" id="purchase_order_form_view_punchout">
        <field name="name">purchase.order.form.punchout</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_punchout_session"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    invisible="not punchout_session_id"
                >
                    <span class="o_stat_text">Punchout</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
