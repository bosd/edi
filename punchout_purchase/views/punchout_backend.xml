<odoo>
    <record id="punchout_backend_form_view" model="ir.ui.view">
        <field name="name">punchout.backend.form.purchase</field>
        <field name="model">punchout.backend</field>
        <field name="inherit_id" ref="punchout.punchout_backend_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_main']" position="after">
                <group string="Purchase">
                    <group>
                        <field name="partner_id" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                    <group>
                        <field name="auto_create_products" />
                        <field
                            name="product_category_id"
                            invisible="not auto_create_products"
                        />
                        <field
                            name="punchout_hide_setup_hint"
                            invisible="state == 'open'"
                        />
                    </group>
                </group>
                <group
                    string="Auto-Created Product Defaults"
                    name="group_auto_create_defaults"
                    invisible="not auto_create_products"
                >
                    <group>
                        <field name="default_product_type" />
                        <field name="default_is_storable" />
                    </group>
                    <group>
                        <field
                            name="default_tracking"
                            invisible="not default_is_storable"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="punchout_backend_tree_view" model="ir.ui.view">
        <field name="name">punchout.backend.list.purchase</field>
        <field name="model">punchout.backend</field>
        <field name="inherit_id" ref="punchout.punchout_backend_tree_view" />
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="partner_id" optional="show" />
            </field>
        </field>
    </record>

    <!-- End-user-facing menu: Purchase > Suppliers (PunchOut). Points
         at the picker action from the base ``punchout`` module —
         strict domain (active=True, state=open) so purchasers only
         see suppliers they can actually click on. Visible to
         everyone with backend read access (base.group_user, set on
         the model ACL). Setup / curation lives elsewhere (PunchOut
         Backends menu, manager-gated). -->
    <menuitem
        id="purchase_punchout_supplier_picker_menu"
        name="PunchOut Suppliers"
        parent="purchase.menu_procurement_management"
        action="punchout.punchout_supplier_picker_act_window"
        sequence="100"
    />
</odoo>
